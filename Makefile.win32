# Gateway for Windows 95 OSR2 and up.
#
#   make -f Makefile.win32
#
# Cross-compiles from Linux or macOS with MinGW-w64; CROSS overrides the
# prefix. The Mac OS 9 build is CMake plus Retro68 and shares none of this,
# which is why it is a separate file rather than a branch in CMakeLists.txt.

CROSS ?= i686-w64-mingw32-
CC     = $(CROSS)gcc
STRIP  = $(CROSS)strip
WINDRES= $(CROSS)windres

CERT   = third_party/certainly
BEAR   = $(CERT)/bearssl

# 0x0400 is Windows 95 / NT 4.0. __USE_MINGW_ANSI_STDIO gives the C99 printf
# family from libmingwex instead of msvcrt's _snprintf, which does not
# null-terminate on truncation and returns -1 rather than the length needed --
# semantics several accumulating snprintf call sites here depend on.
# Stamped into the binary so a screenshot of the log identifies the build.
GW_BUILD_ID := $(shell git rev-parse --short HEAD 2>/dev/null || echo unknown)

#
# BearSSL's inner.h turns on BR_USE_WIN32_RAND for any _WIN32 target, which
# compiles a CryptGenRandom-based seeder in src/rand/sysrng.c and puts a second
# ADVAPI32 Crypt* import in the binary -- the one entropy_win32.c goes to
# trouble to avoid, since a machine without CryptoAPI then refuses to load the
# image at all (Gateway#1). We never use that seeder: certainly.c injects our
# own pool into every engine before the handshake, which sets rng_init_done and
# stops BearSSL consulting br_prng_seeder_system. The Mac OS 9 build has run in
# exactly this configuration since day one, where no seeder is compiled in at
# all, so switching it off here is the arrangement already in daily use.
DEFS   = -D_WIN32_WINNT=0x0400 -DWINVER=0x0400 -D__USE_MINGW_ANSI_STDIO=1 \
         -DBR_USE_WIN32_RAND=0 \
         -DGW_BUILD_ID=\"$(GW_BUILD_ID)\"
INCS   = -Isrc -Isrc/portable -I$(CERT)/include -I$(CERT)/src \
         -I$(BEAR)/inc -I$(BEAR)/src
# Optimisation was briefly a suspect and is not one.
#
# Building unoptimised changed the symptom, which looked like evidence and was
# not: the real fault was HKDF writing past the end of its output buffer
# (PATCHES.md §19), so which key got destroyed depended on how the compiler had
# arranged the stack. Any level was wrong, differently. Back to -Os, which is
# 580 KB against 790 KB, and still overridable:
#
#   make -f Makefile.win32 OPT="-O0"
OPT ?= -Os

CFLAGS = $(DEFS) $(INCS) $(OPT) -ffunction-sections -fdata-sections \
         -Wall -Wextra -Wno-unused-parameter

# -mwindows for a GUI subsystem: no console window behind the tray icon.
# The subsystem and OS versions are pinned to 4.0 because Windows 95 refuses
# anything newer, whatever the imports say. MinGW-w64 already writes 4.0, so
# this only keeps a future toolchain from quietly raising it.
LDFLAGS = -mwindows -Wl,--gc-sections \
          -Wl,--major-subsystem-version=4 -Wl,--minor-subsystem-version=0 \
          -Wl,--major-os-version=4 -Wl,--minor-os-version=0
# No -lshell32. The one function Gateway wants from it, Shell_NotifyIconA, is
# looked up at run time so that a shell without a notification area leaves us
# short an icon rather than unable to load. Leaving the import library out
# turns that into something the linker enforces: if a shell32 call is ever
# added back by hand, the build fails here instead of the binary quietly
# growing an import that only fails on hardware nobody here owns.
LIBS    = -lwsock32 -luser32 -lgdi32 -ladvapi32 -lkernel32

SRC = \
  $(wildcard src/portable/*.c) \
  $(wildcard src/proxy/*.c) \
  src/gw_core.c src/gw_config.c src/gw_plat_win32.c \
  src/net/gw_stream.c src/net/gw_net_win32.c \
  src/win32/main_win32.c \
  $(CERT)/src/certainly.c \
  $(CERT)/src/transport_win32.c \
  $(CERT)/src/entropy_win32.c \
  $(CERT)/src/ca_roots.c \
  $(CERT)/src/tls13_keysched.c \
  $(CERT)/src/tls13_record.c \
  $(CERT)/src/tls13_handshake.c \
  $(wildcard $(BEAR)/src/*/*.c) \
  $(wildcard $(BEAR)/src/*.c)

OBJ = $(SRC:%.c=build-win32/%.o) build-win32/gateway.res.o

all: build-win32/Gateway.exe

build-win32/Gateway.exe: $(OBJ)
	@mkdir -p $(dir $@)
	$(CC) $(LDFLAGS) -o $@ $(OBJ) $(LIBS)
	$(STRIP) $@

build-win32/%.o: %.c
	@mkdir -p $(dir $@)
	$(CC) $(CFLAGS) -c -o $@ $<

# The icon and the version block. windres needs the .rc's own directory on its
# include path so the ICON statement can find gateway.ico beside it.
build-win32/gateway.res.o: src/win32/gateway.rc src/win32/gateway.ico \
                           src/win32/gateway-on.ico src/win32/gateway-off.ico
	@mkdir -p $(dir $@)
	$(WINDRES) -I src/win32 -i $< -o $@ -O coff

clean:
	rm -rf build-win32

.PHONY: all clean
