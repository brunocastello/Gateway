/*
 * gateway.rc - the Windows resources: the icon, and the version block.
 *
 * gateway.ico is generated from the same pixel arrays as the Mac OS 9 icon by
 * tools/generate_icon.py, so the two platforms carry one piece of artwork
 * rather than two that resemble each other:
 *
 *     python3 tools/generate_icon.py --out src/ui/gateway_icon.r \
 *                                    --ico src/win32/gateway.ico
 *
 * The numbers below have to match GW_VERSION_STRING in src/gw_version.h. The
 * resource compiler cannot read that header, which is exactly how the About
 * box came to disagree with the 'vers' resource at 0.2.0.
 */

#include <windows.h>

/*
 * Lowest id wins when the shell picks an application's icon, so the ordinary
 * blue one is 1: that is Gateway in Explorer, on the taskbar and in the window
 * caption, regardless of what it happens to be doing at the time.
 *
 * The tray icon says what it is doing, in the one place a 16x16 image has room
 * to say anything: the opening under the arch, green while running and red
 * while stopped. Same stonework, same padlock, same mask.
 *
 * These ids are what main_win32.c's GW_ICON_* constants name. They were out of
 * step once -- the file kept an older pair while the code had moved to three --
 * and the result was a tray icon that showed red while running and vanished
 * when stopped, because id 3 did not exist and LoadIcon returned nothing.
 */
1 ICON "gateway.ico"
2 ICON "gateway-on.ico"
3 ICON "gateway-off.ico"

VS_VERSION_INFO VERSIONINFO
  FILEVERSION    0,3,2,0
  PRODUCTVERSION 0,3,2,0
  FILEOS         VOS__WINDOWS32
  FILETYPE       VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904E4"          /* US English, Windows multilingual */
    BEGIN
      VALUE "CompanyName",      "Bruno Castello"
      VALUE "FileDescription",  "TLS 1.3 gateway and proxy for vintage clients"
      VALUE "FileVersion",      "0.3.2"
      VALUE "InternalName",     "Gateway"
      VALUE "LegalCopyright",   "MIT licence"
      VALUE "OriginalFilename", "Gateway.exe"
      VALUE "ProductName",      "Gateway"
      VALUE "ProductVersion",   "0.3.2"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1252
  END
END
